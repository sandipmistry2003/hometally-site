# Hostinger (LiteSpeed) rules for hometally.in
Options -Indexes
ErrorDocument 404 /index.html

RewriteEngine On

# The beta site's folder sits inside this one; it's only reachable as beta.hometally.in
RewriteRule ^beta(/|$) - [R=404,L]

# www → main address (GitHub Pages did the same)
RewriteCond %{HTTP_HOST} ^www\.hometally\.in$ [NC]
RewriteRule ^ https://hometally.in%{REQUEST_URI} [L,R=301]

# Clean addresses: /privacy serves privacy.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
